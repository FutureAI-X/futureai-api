# FutureAI API 容器部署配置
#
# 用法: cp .env.example .env && chmod 600 .env
#
# ⚠️ 不要直接复制仓库根目录的 .env。
#    那份是「宿主机直接运行」时的形态，里面的 SQL_DSN 指向 localhost、
#    TRUSTED_PROXIES 是 127.0.0.1/32 —— 在容器里这两项都是错的。
#    本文件已经按容器形态写好，SQL_DSN 与 TRUSTED_PROXIES 不在这里配置，
#    而是由 docker-compose.yml 按容器网络生成。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
POSTGRES_USER=token_hub
POSTGRES_DB=token_hub

# 生成: openssl rand -hex 24
# ⚠️ 该密码在数据卷首次初始化时写进数据库。初始化之后再改这个值，
#    应用就连不上已有数据了 —— 那时需要进容器用 ALTER USER 改。
# ⚠️ 不要用 # $ " ' \ 空格 等字符，compose 的变量插值和 SQL_DSN 拼接都会被它们破坏。
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 安全密钥（两项都必填，服务在缺失或过短时会拒绝启动）
# ---------------------------------------------------------------------------

# JWT 签名密钥。生成: openssl rand -hex 32
JWT_SECRET=

# 敏感数据加密密钥（供应商 API Key 等）。
# 生成: openssl rand -hex 32
# ⚠️ 一旦用于加密数据后不可更改 —— 改了已存的供应商密钥就全部解不开，
#    表现为模型调用全部失败，且无法恢复。
SECRET_KEY=

# ---------------------------------------------------------------------------
# root 初始密码
# ---------------------------------------------------------------------------
#
# 仅在首次启动且 users 表为空时生效。留空则程序随机生成。
#
# ⚠️ 容器部署请务必用这个变量，不要依赖程序自动生成：
#    生成结果会写到工作目录的 root_initial_password.txt，容器以非 root 运行
#    写不进去（只留一条日志），即使写进去了也会随容器重建而消失 ——
#    而数据库里的 root 用户还在，于是你再也拿不到初始密码。
INITIAL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 网关
# ---------------------------------------------------------------------------

# 网关容器在共享网络 gateway-proxy 上的固定 IP。
# 改这里的话 deploy/gateway/docker-compose.yml 里的 ipv4_address 要同步改。
# 它被用来从 X-Forwarded-For 还原真实客户端 IP。
GATEWAY_IP=172.20.0.2

# ---------------------------------------------------------------------------
# 业务参数
# ---------------------------------------------------------------------------

GIN_MODE=release

# 调试模式。开启后会打印 SQL 日志，生产必须保持 false。
DEBUG=false

# /v1 业务接口按用户限流（令牌桶）
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=10

# 图片上传的单次积分成本（默认 0 = 免费）。
# 上传是拿平台自己的供应商密钥把用户文件转存到上游，成本由平台承担。
UPLOAD_CREDITS=0

# 出站代理（可选）。服务器必须经代理才能访问供应商 API 时设置，
# 形如 http://10.0.0.1:3128。留空则直连。
# ⚠️ 本服务刻意不读 HTTP_PROXY / HTTPS_PROXY（环境里意外存在的代理变量
#    会让所有出站流量静默改道），需要代理必须显式设置这一项。
OUTBOUND_PROXY=

# 连接池参数。
# SQL_MAX_OPEN_CONNS 由 compose 覆盖为 80（PostgreSQL 默认 max_connections=100
#   且为超级用户留了几条，配成 100 会在打满时被拒绝连接）。
# SQL_MAX_LIFETIME 是连接寿命（秒），到期归还即关闭；1800 秒是通行值，
#   设成 60 之类的小值等于让整个连接池每分钟重建一遍。
SQL_MAX_IDLE_CONNS=10
SQL_MAX_OPEN_CONNS=80
SQL_MAX_LIFETIME=1800
SQL_MAX_IDLE_TIME=600

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------

# 由 ./deploy/build-image.sh 打出来的标签（构建时刻，形如 20260915225600）。
# 升级和回滚都是改这一行，改完 docker compose up -d。
# 写 latest 也能跑（脚本会顺带打这个标签），但它只指向最后一次 load 进来的版本，
# 出问题时说不清是哪一个 —— 正式部署建议写死具体标签。
TOKEN_HUB_TAG=latest
