# 网关配置。复制成 .env 后填写: cp .env.example .env
#
# 这三个域名会被渲染进 nginx 配置。域名买好之前可以先用占位值，
# 用 curl -H "Host: ..." 或本机 hosts 文件验证链路，等解析生效后再签证书。

# ---- 三个服务各自的域名 ----
# 在 DNS 上把这三条 A 记录都指向服务器 IP。
# 各自走根路径，互不干扰，不需要任何路径前缀改写。
TOKEN_HUB_DOMAIN=token.example.com
NEW_API_DOMAIN=newapi.example.com
SUB2API_DOMAIN=sub2api.example.com

# ---- Let's Encrypt ----
# 证书到期提醒和紧急通知会发到这里。
ACME_EMAIL=admin@example.com
