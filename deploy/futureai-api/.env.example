# FutureAI API 容器部署配置（生产形态）
#
# 用法: cp .env.example .env && chmod 600 .env
#
# 本文件与仓库根目录的 .env.example 是两套，对应两种运行环境，不要互相复制 ——
# 根目录那份用于「宿主机直跑」，这份用于「容器内运行」。差异只有四处：
#   (1) 本文件不含 PORT / SQL_DSN / TRUSTED_PROXIES。容器内的网络视图与宿主机
#       不同，这三项由 docker-compose.yml 按容器网络生成并覆盖。
#   (2) 本文件多 GATEWAY_IP：仅用于生成容器内的 TRUSTED_PROXIES。
#   (3) 本文件多 FUTUREAI_API_TAG：决定跑哪个版本的镜像。
#   (4) 本文件显式给出 POSTGRES_USER / POSTGRES_DB，根目录那份依赖 compose 的默认值。
# 其余各项（密钥、连接池、限流、计费）两份含义完全一致。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# 作用：
#   数据库用户名，postgres 容器与应用侧 SQL_DSN 共用。
# 说明：
#   (1) 默认 futureai_api。
#   (2) 数据卷首次初始化时据此建出该角色。
# 注意：
#   (1) 只在首次初始化时生效：数据卷建好后再改这里，不会改动库里的角色名。
POSTGRES_USER=futureai_api

# 作用：
#   数据库名。
# 说明：
#   (1) 默认 futureai_api。
# 注意：
#   (1) 同 POSTGRES_USER，只在数据卷首次初始化时生效。
POSTGRES_DB=futureai_api

# 作用：
#   数据库密码，postgres 容器用它初始化数据卷，compose 也用它拼出应用的 SQL_DSN。
# 说明：
#   (1) 生成方式 openssl rand -hex 24。
#   (2) 无默认值；留空时 compose 会拒绝启动。
# 注意：
#   (1) 只在数据卷首次初始化时写进数据库。初始化之后再改这个值，应用就连不上
#       已有数据了 —— 那时需要进容器用 ALTER USER 改。
#   (2) 不要用 # $ " ' \ 空格 等字符。尤其是 $：compose 的插值会把它当变量引用
#       展开，展开失败是静默的（变成空串），最后表现为报密码认证失败。
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 密钥与密码
# ---------------------------------------------------------------------------

# 作用：
#   签发与校验登录 Token 的 JWT 签名密钥。
# 说明：
#   (1) 必填，至少 32 字符；生成方式 openssl rand -hex 32。
# 注意：
#   (1) 留空、过短或沿用示例值都会让服务拒绝启动（fail-closed）。
#   (2) 换掉这个值会让所有已签发的 Token 立即失效，用户需重新登录。
JWT_SECRET=

# 作用：
#   加密数据库中供应商 API Key 等敏感字段。
# 说明：
#   (1) 必填，至少 32 字符；生成方式 openssl rand -hex 32。
# 注意：
#   (1) 一旦用于加密数据后不可更改：改了，已存的供应商密钥全部解不开，且
#       无法恢复。
#   (2) 请另抄一份存到密码管理器 —— 丢失等于所有供应商密钥永久不可用。
SECRET_KEY=

# 作用：
#   首次启动时创建的 root 管理员密码。
# 说明：
#   (1) 仅在 users 表为空时生效；留空则随机生成。
# 注意：
#   (1) 容器部署必须设置，不要依赖程序自动生成：生成结果会写到工作目录的
#       root_initial_password.txt，容器以非 root 运行写不进去（只留一条日志），
#       即使写进去也会随容器重建而消失 —— 而库里的 root 用户还在，于是你
#       再也拿不到初始密码。
#   (2) 含 $ 必须用单引号包起来，如 'a$b$c'：双引号仍会被展开成空串，登录时
#       会一直提示密码错。
#   (3) 登录后请立即修改。
INITIAL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 网关
# ---------------------------------------------------------------------------

# 作用：
#   网关容器在共享网络 gateway-proxy 上的固定 IP。compose 用它拼出应用容器的
#   TRUSTED_PROXIES（形如 172.20.0.2/32），应用据此认定「X-Forwarded-For 是网关
#   写的，可以信」，从而还原出真实客户端 IP。
# 说明：
#   (1) 实际地址由 deploy/gateway/docker-compose.yml 的 ipv4_address 决定，
#       两处必须一致。
#   (2) /32 表示只信任这一个地址，而不是整个网段。
#   (3) 默认值 172.20.0.2 与网关那份 compose 一致，通常不需要改。
# 注意：
#   (1) 只有改了网关固定 IP 时才需要动这里，且必须两处同步改 —— 不一致时应用会把
#       请求来源算错，登录限流可能把全体用户当成同一个人。
#   (2) 变量名刻意不叫 TRUSTED_PROXIES：compose 会用本目录的 .env 做插值，若照抄
#       宿主机那份（127.0.0.1/32），应用会认不出网关，后果同上。
GATEWAY_IP=172.20.0.2

# ---------------------------------------------------------------------------
# 业务
# ---------------------------------------------------------------------------

# 作用：
#   Gin 框架运行模式。
# 说明：
#   (1) 取值 debug / release，默认 release。
#   (2) 只有 "debug" 会开启调试模式，其余值一律按 release 处理。
# 注意：
#   (1) 生产必须 release：debug 会打印每个请求的详细日志，性能也更差。
GIN_MODE=release

# 作用：
#   是否打印 SQL 日志。
# 说明：
#   (1) 取值 true / false，默认 false。
#   (2) 开启后由 GORM 输出实际执行的语句。
# 注意：
#   (1) 仅用于本地排查：生产开启会把 SQL 语句连同参数写进日志。
DEBUG=false

# 作用：
#   /v1 接口按用户维度的限流速率（令牌桶）。
# 说明：
#   (1) 单位次/分钟，默认 60。
#   (2) 在 API Key 校验之后生效，因此按用户计而不是按 IP。
# 注意：
#   (1) 限流用来约束上游额度消耗：这些端点每次调用都真实花费供应商配额。
API_RATE_LIMIT_PER_MINUTE=60

# 作用：
#   限流允许的瞬时突发量（令牌桶容量）。
# 说明：
#   (1) 默认 10。
# 注意：
#   (1) 配得远大于每分钟速率时，单用户在短时间内可发出的请求数会明显超过
#       PER_MINUTE。
API_RATE_LIMIT_BURST=10

# 作用：
#   图片上传接口单次扣除的积分。
# 说明：
#   (1) 端点 /v1/uploads/images；默认 0 = 免费。
# 注意：
#   (1) 上传是拿平台自己的供应商密钥把用户文件转存到上游，存储与带宽成本
#       全部由平台承担。
#   (2) 保持 0 又不限速时，任何持有效 API Key 的用户（哪怕余额为 0）都能以
#       每分钟 60 次的速率持续消耗。
#   (3) 配置非法（负数、非数字）时按 0 处理并打错误日志，不会拒绝启动。
UPLOAD_CREDITS=0

# 作用：
#   必须经代理才能访问供应商 API 时，出站请求走的代理。
# 说明：
#   (1) 形如 http://10.0.0.1:3128，支持 http/https/socks5。
#   (2) 默认留空 = 直连。
# 注意：
#   (1) 刻意不复用 HTTP_PROXY / HTTPS_PROXY：环境里意外存在的代理变量会让
#       所有出站流量（含随请求发出的供应商 API Key）静默改道。
#   (2) 启用后目标地址不再逐 IP 校验（拨号终点变成代理本身），请确保代理侧
#       有出网管控。
OUTBOUND_PROXY=

# 作用：
#   连接池允许保持的最大空闲连接数。
# 说明：
#   (1) 默认 10。
# 注意：
#   (1) 空闲连接会一直占着数据库侧的后端进程；配得比 OPEN_CONNS 大没有意义。
SQL_MAX_IDLE_CONNS=10

# 作用：
#   连接池同时打开的最大连接数。
# 说明：
#   (1) 默认 80；docker-compose.yml 按此值透传给应用。
# 注意：
#   (1) 别配到 100：PostgreSQL 默认 max_connections=100 且为超级用户留了
#       几条，打满时会被数据库拒绝连接。
SQL_MAX_OPEN_CONNS=80

# 作用：
#   连接的最长存活时间（秒），到期归还即被关闭。
# 说明：
#   (1) 默认 1800。
# 注意：
#   (1) 配得太短（如 60）等于让整个连接池每分钟重建一遍。PostgreSQL 每个连接
#       都是独立后端进程，重建要 fork 加认证往返，还占着可观的常驻内存。
SQL_MAX_LIFETIME=1800

# 作用：
#   空闲连接的最长存活时间（秒）。
# 说明：
#   (1) 默认 600。
# 注意：
#   (1) 只限寿命不限空闲的话，低峰期攒下的空闲连接会一直占着数据库侧进程，
#       直到寿命到期。
#   (2) 配 0 或负数表示不因空闲而关闭连接。
SQL_MAX_IDLE_TIME=600

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------

# 作用：
#   应用容器使用的镜像标签，决定跑哪个版本。
# 说明：
#   (1) 由 ./deploy/build-image.sh 打出，形如 20260915225600。
#   (2) 升级与回滚都是改这一行，改完 docker compose up -d。
# 注意：
#   (1) 无默认值：compose 在缺失或为空时会拒绝启动。
#   (2) 正式部署建议写死具体标签。latest 只指向最后一次 load 进来的版本，
#       出问题时说不清是哪一个。
#   (3) 升级前务必先备份数据库：应用启动会跑 AutoMigrate，部分变更不可逆，
#       回滚旧镜像不一定能回到旧 schema。
FUTUREAI_API_TAG=latest
