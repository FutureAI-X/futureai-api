{
  "params": [
    {
      "key": "prompt",
      "widget": "textarea",
      "label": "提示词",
      "group": "basic",
      "required": true,
      "min_length": 1,
      "max_length": 2000,
      "count_mode": "codepoint"
    },
    {
      "key": "size",
      "widget": "ratio_size",
      "label": "尺寸",
      "group": "basic",
      "default": "16:9",
      "ratios": [
        "1:1", "3:2", "2:3", "4:3", "3:4",
        "5:4", "4:5", "16:9", "9:16", "21:9"
      ]
    },
    {
      "key": "resolution",
      "widget": "segmented",
      "label": "分辨率",
      "group": "basic",
      "default": "1K",
      "options": ["1K", "2K", "4K"]
    },
    {
      "key": "quality",
      "widget": "segmented",
      "label": "质量",
      "group": "advanced",
      "default": "auto",
      "options": [
        { "label": "自动", "value": "auto" },
        { "label": "低", "value": "low" },
        { "label": "中", "value": "medium" },
        { "label": "高", "value": "high" },
        { "label": "极高", "value": "xhigh" },
        { "label": "最高", "value": "max" }
      ]
    },
    {
      "key": "output_format",
      "widget": "segmented",
      "label": "输出格式",
      "group": "advanced",
      "default": "png",
      "options": [
        { "label": "PNG", "value": "png" },
        { "label": "JPEG", "value": "jpeg" },
        { "label": "WebP", "value": "webp" }
      ]
    },
    {
      "key": "complexity",
      "widget": "segmented",
      "label": "画面复杂度",
      "group": "advanced",
      "options": [
        { "label": "低", "value": "low" },
        { "label": "中", "value": "medium" },
        { "label": "高", "value": "high" }
      ]
    },
    {
      "key": "images",
      "path": "image_ids",
      "widget": "ref_images",
      "label": "参考图",
      "group": "reference",
      "max_count": 16,
      "max_file_bytes": 10485760,
      "max_total_bytes": 268435456,
      "allowed_mime_types": ["image/png", "image/jpeg", "image/webp"]
    }
  ]
}
