{
  "params": [
    {
      "key": "prompt",
      "widget": "textarea",
      "label": "提示词",
      "group": "basic",
      "required": true,
      "min_length": 1,
      "max_length": 2000,
      "count_mode": "codepoint"
    },
    {
      "key": "size",
      "widget": "ratio_size",
      "label": "尺寸",
      "group": "basic",
      "default": "16:9",
      "modes": ["ratio", "pixel"],
      "ratios": [
        "1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5",
        "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"
      ],
      "pixel": {
        "step": 16,
        "min_side": 0,
        "max_side": 3840,
        "min_pixels": 0,
        "max_pixels": 8294400,
        "aspect": { "min": "1:3", "max": "3:1" }
      }
    },
    {
      "key": "resolution",
      "widget": "segmented",
      "label": "分辨率",
      "group": "basic",
      "default": "1K",
      "options": ["1K", "2K", "4K"]
    },
    {
      "key": "images",
      "path": "image_ids",
      "widget": "ref_images",
      "label": "参考图",
      "group": "reference",
      "max_count": 15,
      "max_file_bytes": 10485760,
      "max_total_bytes": 268435456,
      "allowed_mime_types": ["image/png", "image/jpeg", "image/webp"]
    }
  ]
}
