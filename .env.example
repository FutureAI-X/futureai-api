# FutureAI API 环境变量配置
#
# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已被 gitignore，绝不要提交它。

# 服务端口
PORT=3001

# Gin 模式 (debug/release)
# 生产环境必须设为 release
GIN_MODE=release

# PostgreSQL 数据库连接字符串 (必须)
# 格式: postgres://用户名:密码@主机:端口/数据库名?sslmode=disable
SQL_DSN=postgres://futureai_api:CHANGE_ME@localhost:5432/futureai_api?sslmode=disable

# 连接池配置
#
# SQL_MAX_OPEN_CONNS 默认 80：PostgreSQL 默认 max_connections 是 100，
#   且为超级用户预留了几条，配成 100 会在打满时被数据库拒绝连接。
# SQL_MAX_LIFETIME 默认 1800（秒）：连接到期归还即被关闭，
#   设得太短（例如 60）等于让整个连接池每分钟重建一遍，
#   而 PostgreSQL 每个连接都是一个独立后端进程。
# SQL_MAX_IDLE_TIME 限制空闲连接存活时间，避免低峰期一直占着数据库侧进程。
SQL_MAX_IDLE_CONNS=10
SQL_MAX_OPEN_CONNS=80
SQL_MAX_LIFETIME=1800
SQL_MAX_IDLE_TIME=600

# JWT 密钥（用于生成和验证 Token）
# 必填！至少 32 字符。留空或使用示例值将导致服务拒绝启动。
# 生成方式: openssl rand -hex 32
JWT_SECRET=

# 敏感数据加密密钥（用于加密存储供应商 API Key 等）
# 必填！至少 32 字符。留空或使用示例值将导致服务拒绝启动。
# 注意：该密钥一旦用于加密数据后不可更改，否则已存的供应商密钥将无法解密。
#       请单独备份到密码管理器——丢失即等于所有供应商密钥永久不可用。
# 生成方式: openssl rand -hex 32
SECRET_KEY=

# 反向代理网段（逗号分隔的 IP 或 CIDR）
# 仅在服务部署于 Nginx/CDN 之后时设置，用于从 X-Forwarded-For 还原真实客户端 IP。
# 留空则直接使用 TCP 对端地址（更安全，但反向代理后所有请求的 IP 都相同）。
# 示例: TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
#
# ⚠️ 配错的后果很重：设在代理之后却留空时，所有请求的来源 IP 都是网关地址，
#    登录限流会把全体用户视为同一个人——攻击者每 5 分钟发 5 次错误密码，
#    就能让全站用户 5 分钟内无法登录。
# ⚠️ 切勿填 0.0.0.0/0：那等于信任一切，X-Forwarded-For 可被任意伪造。
TRUSTED_PROXIES=

# 出站代理（可选，形如 http://10.0.0.1:3128，支持 http/https/socks5）
#
# 服务器必须经代理才能访问供应商 API 时设置。刻意不复用 HTTP_PROXY /
# HTTPS_PROXY：环境里意外存在的代理变量会让**所有**出站流量（含随请求发出的
# 供应商 API Key）静默改道，生产上极难定位。
#
# ⚠️ 启用后目标地址不再逐 IP 校验（拨号终点变成代理本身），
#    请确保代理侧有出网管控。
OUTBOUND_PROXY=

# /v1 业务接口限流（按用户维度，令牌桶）
# 默认 60 次/分钟，允许瞬时突发 10 次
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BURST=10

# 图片上传的单次积分成本（/v1/uploads/images）
# 默认 0 = 免费，保持既有行为。但请注意：上传端点是拿平台自己的供应商密钥
# 把用户文件转存到上游的，存储与带宽成本全部由平台承担。不收费又不限速时，
# 任何持有效 API Key 的用户（哪怕余额为 0）都能以每分钟 60 次持续消耗。
UPLOAD_CREDITS=0

# root 初始密码（可选）
# 首次启动且 users 表为空时使用。不设置则随机生成并写入
# ./root_initial_password.txt（权限 0600）。无论哪种方式都请登录后立即修改。
#
# 容器部署请务必用本变量：容器内以非 root 用户运行，写文件会因权限不足失败。
INITIAL_ROOT_PASSWORD=

# 调试模式（true/false）
# 开启后会打印 SQL 日志，仅用于本地排查，生产必须保持 false。
DEBUG=false

# PostgreSQL 容器密码（仅 docker-compose 使用）
# 必须设置，否则 docker-compose 会拒绝启动
POSTGRES_PASSWORD=
