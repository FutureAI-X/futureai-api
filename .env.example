# FutureAI API 环境变量配置
#
# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已被 gitignore，绝不要提交它。
# 各项的完整说明见 docs/DEVELOPMENT.md 第九节。

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------

# 作用：
#   HTTP 服务监听端口。
# 说明：
#   (1) 默认 3001。
#   (2) 容器映射到宿主机 8080，因此容器与本机直跑能同时开着。
# 注意：
#   (1) 只对本机直跑生效：两份 compose 都把容器内端口写死为 3001。
PORT=3001

# 作用：
#   Gin 框架运行模式。
# 说明：
#   (1) 取值 debug / release，默认 release。
#   (2) 只有 "debug" 会开启调试模式，其余值一律按 release 处理。
# 注意：
#   (1) 生产必须 release：debug 会打印每个请求的详细日志，性能也更差。
GIN_MODE=release

# 作用：
#   是否打印 SQL 日志。
# 说明：
#   (1) 取值 true / false，默认 false。
#   (2) 开启后由 GORM 输出实际执行的语句。
# 注意：
#   (1) 仅用于本地排查：生产开启会把 SQL 语句连同参数写进日志。
DEBUG=false

# ---------------------------------------------------------------------------
# 密钥与密码
# ---------------------------------------------------------------------------

# 作用：
#   签发与校验登录 Token 的 JWT 签名密钥。
# 说明：
#   (1) 必填，至少 32 字符；生成方式 openssl rand -hex 32。
# 注意：
#   (1) 留空、过短或沿用示例值都会让服务拒绝启动（fail-closed）。
#   (2) 换掉这个值会让所有已签发的 Token 立即失效，用户需重新登录。
JWT_SECRET=

# 作用：
#   加密数据库中供应商 API Key 等敏感字段。
# 说明：
#   (1) 必填，至少 32 字符；生成方式 openssl rand -hex 32。
# 注意：
#   (1) 一旦用于加密数据后不可更改：改了，已存的供应商密钥全部解不开，且
#       无法恢复。
#   (2) 请另抄一份存到密码管理器 —— 丢失等于所有供应商密钥永久不可用。
SECRET_KEY=

# 作用：
#   本地开发库的密码，供 docker compose 建库，并被下面的 SQL_DSN 引用。
# 说明：
#   (1) 生成方式 openssl rand -hex 24。
#   (2) 无默认值；留空时 compose 会拒绝启动。
# 注意：
#   (1) 必须写在 SQL_DSN 上方。godotenv 只展开位于引用行上方的变量，写反了
#       不报错，只会把密码展开成空串，症状是连接被数据库拒绝认证。
#   (2) 只能用 hex / base64url：该值被原样拼进连接串，@ : / # 会把它拆坏。
#   (3) 密码只在数据卷首次初始化时写进数据库，之后改这里不会同步过去。
POSTGRES_PASSWORD=

# 作用：
#   首次启动时创建的 root 管理员密码。
# 说明：
#   (1) 仅在 users 表为空时生效；留空则随机生成并写入
#       ./root_initial_password.txt（权限 0600）。
#   (2) 无默认值。
# 注意：
#   (1) 含 $ 必须用单引号包起来，如 'a$b$c'：双引号仍会被展开成空串，登录时
#       会一直提示密码错。
#   (2) 容器部署必须设置：容器内写文件会因权限不足失败，之后就再也拿不到
#       密码了。
#   (3) 无论哪种方式，登录后请立即修改。
INITIAL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# 作用：
#   数据库用户名，postgres 容器、备份脚本与 SQL_DSN 共用。
# 说明：
#   (1) 默认 futureai_api；compose 与 deploy 下的备份/恢复脚本用的是同一个默认值。
#   (2) SQL_DSN 引用本项，改这里连接串里的用户名跟着变。
# 注意：
#   (1) 只在数据卷首次初始化时生效：数据卷已存在时改这里不会改动库里的角色，
#       反而会让应用连不上。
#   (2) 同 POSTGRES_PASSWORD，必须留在 SQL_DSN 上方。
POSTGRES_USER=futureai_api

# 作用：
#   数据库名，postgres 容器、备份脚本与 SQL_DSN 共用。
# 说明：
#   (1) 默认 futureai_api。
#   (2) SQL_DSN 引用本项，改这里连接串里的库名跟着变。
# 注意：
#   (1) 只在数据卷首次初始化时生效：数据卷已存在时改这里不会改动库名。
#   (2) 同 POSTGRES_PASSWORD，必须留在 SQL_DSN 上方。
POSTGRES_DB=futureai_api

# 作用：
#   PostgreSQL 连接字符串。
# 说明：
#   (1) 格式 postgres://用户名:密码@主机:端口/数据库名?sslmode=disable。
#   (2) 用户名、密码、库名分别引用上面的 POSTGRES_USER / POSTGRES_PASSWORD /
#       POSTGRES_DB，改其中任一项都只需改一处。
#   (3) 本机直跑填 localhost:5432；容器内由 compose 覆盖为服务名 postgres。
# 注意：
#   (1) 变量名只认 [A-Z0-9_]：写成 ${postgres_password} 不会被展开，也不报错，
#       只会得到空密码。
#   (2) 指向的库若不是 compose 建的那个，要么把它的账号密码设成上面三项，
#       要么把这条改回明文写死。
SQL_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# 作用：
#   连接池允许保持的最大空闲连接数。
# 说明：
#   (1) 默认 10。
# 注意：
#   (1) 空闲连接会一直占着数据库侧的后端进程；配得比 OPEN_CONNS 大没有意义。
SQL_MAX_IDLE_CONNS=10

# 作用：
#   连接池同时打开的最大连接数。
# 说明：
#   (1) 默认 80。
# 注意：
#   (1) 别配到 100：PostgreSQL 默认 max_connections=100 且为超级用户留了
#       几条，打满时会被数据库拒绝连接。
SQL_MAX_OPEN_CONNS=80

# 作用：
#   连接的最长存活时间（秒），到期归还即被关闭。
# 说明：
#   (1) 默认 1800。
# 注意：
#   (1) 配得太短（如 60）等于让整个连接池每分钟重建一遍。PostgreSQL 每个连接
#       都是独立后端进程，重建要 fork 加认证往返，还占着可观的常驻内存。
SQL_MAX_LIFETIME=1800

# 作用：
#   空闲连接的最长存活时间（秒）。
# 说明：
#   (1) 默认 600。
# 注意：
#   (1) 只限寿命不限空闲的话，低峰期攒下的空闲连接会一直占着数据库侧进程，
#       直到寿命到期。
#   (2) 配 0 或负数表示不因空闲而关闭连接。
SQL_MAX_IDLE_TIME=600

# ---------------------------------------------------------------------------
# 网络
# ---------------------------------------------------------------------------

# 作用：
#   告诉应用「哪些地址是我们自己的代理」。应用用它决定登录限流按哪个 IP 计数：
#   只有当 TCP 对端落在下面列出的网段内时，才去读 X-Forwarded-For 里的客户端
#   IP；否则一律按 TCP 对端地址算。
# 说明：
#   (1) 逗号分隔的 IP 或 CIDR，如 172.20.0.2/32,10.0.0.0/8。
#   (2) 留空 = 谁的代理头都不信，直接用 TCP 对端地址（最安全）。
#   (3) 本机直跑和本地 compose 前面都没有代理，因此保持留空即可。
#   (4) 生产不在这里填：deploy 那份 compose 会按 GATEWAY_IP 自动生成并覆盖本项。
# 注意：
#   (1) 全应用只有登录限流用到客户端 IP（5 分钟内同一来源失败 5 次即拒），
#       填错不影响其它功能。
#   (2) 部署在代理之后却留空时，所有请求的来源都会被算成网关那一个 IP，登录限流
#       会把全体用户当成同一个人 —— 攻击者发 5 次错密码就能让全站 5 分钟内无法
#       登录。
#   (3) 切勿填 0.0.0.0/0：那等于信任一切，客户端自带的 X-Forwarded-For 重新变得
#       可伪造，攻击者每次换一个假 IP 就能绕过登录限流。
TRUSTED_PROXIES=

# 作用：
#   必须经代理才能访问供应商 API 时，出站请求走的代理。
# 说明：
#   (1) 形如 http://10.0.0.1:3128，支持 http/https/socks5。
#   (2) 默认留空 = 直连。
# 注意：
#   (1) 刻意不复用 HTTP_PROXY / HTTPS_PROXY：环境里意外存在的代理变量会让
#       所有出站流量（含随请求发出的供应商 API Key）静默改道。
#   (2) 启用后目标地址不再逐 IP 校验（拨号终点变成代理本身），请确保代理侧
#       有出网管控。
OUTBOUND_PROXY=

# ---------------------------------------------------------------------------
# 业务
# ---------------------------------------------------------------------------

# 作用：
#   /v1 接口按用户维度的限流速率（令牌桶）。
# 说明：
#   (1) 单位次/分钟，默认 60。
#   (2) 在 API Key 校验之后生效，因此按用户计而不是按 IP。
# 注意：
#   (1) 限流用来约束上游额度消耗：这些端点每次调用都真实花费供应商配额。
API_RATE_LIMIT_PER_MINUTE=60

# 作用：
#   限流允许的瞬时突发量（令牌桶容量）。
# 说明：
#   (1) 默认 10。
# 注意：
#   (1) 配得远大于每分钟速率时，单用户在短时间内可发出的请求数会明显超过
#       PER_MINUTE。
API_RATE_LIMIT_BURST=10

# 作用：
#   图片上传接口单次扣除的积分。
# 说明：
#   (1) 端点 /v1/uploads/images；默认 0 = 免费。
# 注意：
#   (1) 上传是拿平台自己的供应商密钥把用户文件转存到上游，存储与带宽成本
#       全部由平台承担。
#   (2) 保持 0 又不限速时，任何持有效 API Key 的用户（哪怕余额为 0）都能以
#       每分钟 60 次的速率持续消耗。
#   (3) 配置非法（负数、非数字）时按 0 处理并打错误日志，不会拒绝启动。
UPLOAD_CREDITS=0

# ---------------------------------------------------------------------------
# 容器（仅本地开发栈使用）
# ---------------------------------------------------------------------------

# 作用：
#   本地开发栈使用的镜像标签，决定 build 出的镜像叫什么，以及用哪个已存在的镜像。
# 说明：
#   (1) 默认 latest。
#   (2) 只在用 docker compose 起应用容器时才读；本机 go run 不读这一项。
# 注意：
#   (1) 生产部署用 deploy/futureai-api/.env.example 里的同名项，与本项无关。
FUTUREAI_API_TAG=latest
